{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tracer",
  "version": "0.1.0",
  "identifier": "com.tracer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tracer",
        "width": 470,
        "height": 888,
        "minWidth": 470,
        "maxWidth": 470,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#181b1f",
        "url": "/"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Rotation Studio",
    "copyright": "© 2026 Rotation Studio",
    "shortDescription": "Local AI-text detector",
    "longDescription": "Tracer is a local AI-text detector. Paste text and get a per-sentence read on how likely it is to be machine-written. Everything runs on your machine and pasted text never leaves it; it is a rough gauge, not proof.",
    "category": "Utility",
    "homepage": "https://github.com/garethllew/tracerapp",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
